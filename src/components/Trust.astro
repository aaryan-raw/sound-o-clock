---
import { site } from "../data/site.js";
---
<aside class="trust" aria-label="Customer rating"><div class="wrap">
  <p class="score">{site.rating.score}<small> / 5</small></p>
  <p>Rated on Google from {site.rating.count} reviews. <a href={site.mapsUrl} rel="noopener">Read them on Google</a></p>
  <p class="muted">Sessions run by an experienced engineer, in a studio in Jagathy, Thiruvananthapuram.</p>
</div></aside>
