---
import { site, publicServices as services } from "../data/site.js";
---
<form id="enq" novalidate data-wa={site.whatsapp}>
  <label for="f-name">Your name</label>
  <input id="f-name" name="name" autocomplete="name" autocapitalize="words" enterkeyhint="next" required aria-describedby="name-err" />
  <p class="err" id="name-err"></p>
  <label for="f-service">What do you need?</label>
  <select id="f-service" name="service">{services.map(s=><option value={s.name}>{s.name}</option>)}<option>Something else</option></select>
  <label for="f-msg">About your project</label>
  <textarea id="f-msg" name="msg" required aria-describedby="msg-err" placeholder="Song or script, language, number of tracks"></textarea>
  <p class="err" id="msg-err"></p>
  <label for="f-when">Preferred timing (optional)</label>
  <input id="f-when" name="when" placeholder="For example: next week, evenings" />
  <button class="btn primary" type="submit">Send request on WhatsApp</button>
  <p id="enq-status" role="status" class="note"></p>
  <p class="note">This opens WhatsApp with your message ready to edit. Sending an enquiry does not guarantee a booking. We will contact you to confirm availability.</p>
</form>
<script src="../scripts/enquiry.js"></script>
