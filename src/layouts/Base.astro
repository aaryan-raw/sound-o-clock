---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import { site } from "../data/site.js";
import serifFont from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import sansFont from "@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url";
const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const og = Astro.site ? new URL("/og.png", Astro.site).href : null;
const ld = {"@context":"https://schema.org","@type":"LocalBusiness",name:site.name,telephone:site.tel,
  ...(Astro.site?{url:Astro.site.href}:{}),
  address:{"@type":"PostalAddress",streetAddress:"TC 16/951-2, Mythri Nagar, Jagathy",addressLocality:"Thiruvananthapuram",addressRegion:"Kerala",postalCode:"695014",addressCountry:"IN"},
  hasMap:site.mapsUrl};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta name="theme-color" content="#12100e" />
  {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content={site.name} /><meta property="og:locale" content="en_IN" />
  {canonical && <meta property="og:url" content={canonical} />}
  {og && <meta property="og:image" content={og} />}{og && <meta name="twitter:card" content="summary_large_image" />}
  <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body><a class="skip" href="#main">Skip to content</a><Header /><main id="main"><slot /></main><Footer /><MobileBar />
</body></html>
